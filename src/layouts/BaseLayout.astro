---
import '../styles/global.css';
import { site } from '../config';
import { useTranslations, type Lang, languages } from '../i18n/ui';
import { base } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const { title, description, lang = 'fr' } = Astro.props;
const t = useTranslations(lang);

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} · ${site.role[lang]}`;
const metaDescription = description || site.lede[lang];

// Prefix pour les liens selon la langue (FR à la racine, EN/ES avec préfixe)
const prefix = base + (lang === 'fr' ? '' : `/${lang}`);

// Année pour le footer
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    <!-- Applique le thème enregistré avant le premier rendu, pour éviter un flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : lang === 'en' ? 'en_US' : 'es_ES'} />

    <!-- Polices : Newsreader (serif éditoriale) + Inter (sans-serif discret) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- KaTeX pour les formules mathématiques dans les articles -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />

    <!-- Feed RSS -->
    <link rel="alternate" type="application/rss+xml" title={site.name} href={`${base}/rss.xml`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={`${prefix}/`} class="site-name">{site.name}</a>
        <nav>
          <a href={`${prefix}/bio`}>{t('nav.bio')}</a>
          <a href={`${prefix}/recherche`}>{t('nav.research')}</a>
          <a href={`${prefix}/ecrits`}>{t('nav.writings')}</a>
          <a href={`${prefix}/contact`}>{t('nav.contact')}</a>
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Basculer le mode sombre"
          >
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="lang-switch">
          {Object.entries(languages).map(([code, label]) => (
            <a
              href={code === 'fr' ? `${base}/` : `${base}/${code}/`}
              class={code === lang ? 'active' : ''}
            >
              {label}
            </a>
          ))}
        </div>
        <div>
          © {year} {site.name} · {t('footer.rights')}
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const button = document.getElementById('theme-toggle');
        if (!button) return;
        button.addEventListener('click', function () {
          const root = document.documentElement;
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const current = root.getAttribute('data-theme') || (prefersDark ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
        });
      })();
    </script>
  </body>
</html>
